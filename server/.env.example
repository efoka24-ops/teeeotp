# teeeotp — environnement.
#
# A deposer en /home/<compte>/teeeotp.env, HORS de public_html : aucune URL ne
# peut alors l'atteindre. Le repli public_html/teeeotp/.env n'est protege que
# par le .htaccess.

PUBLIC_URL=https://trugroup.cm/teeeotp

# ─── Base de donnees (MySQL cPanel) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ─── Secrets ────────────────────────────────────────────────────────────────
# Sel des cles API et des jetons de telephone. NE JAMAIS CHANGER apres
# creation : toutes les cles et tous les jetons deviendraient invalides.
API_KEY_SALT=
# Poivre des codes OTP (HMAC). Le changer invalide seulement les codes en cours.
OTP_PEPPER=
# Cle d'administration (en-tete X-Admin-Key). Vide = administration fermee.
ADMIN_API_KEY=
# Jeton de install.php. A vider une fois l'installation faite.
INSTALL_TOKEN=

# ─── OTP ────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Au plus OTP_RATE_MAX_PER_PHONE codes par numero sur OTP_RATE_WINDOW_SECONDS.
OTP_RATE_MAX_PER_PHONE=3
OTP_RATE_WINDOW_SECONDS=900
# Meme fenetre, pour les cles de test (compte par projet).
OTP_TEST_RATE_MAX_PER_PHONE=10

# ─── Mode test ──────────────────────────────────────────────────────────────
# Vrais SMS accordes par defaut a un nouveau projet avec sa cle de test ;
# au-dela, les envois sont simules. Reglable projet par projet au back-office.
TEST_SMS_LIMIT=5

# ─── SMS et telephones ──────────────────────────────────────────────────────
# Plafond de SMS par jour, tous projets confondus : protege le forfait.
GLOBAL_DAILY_CAP=1000
# Rythme impose aux telephones (renvoye a chaque claim).
GATEWAY_POLL_MS=3000
GATEWAY_SEND_DELAY_MS=1500
# Un telephone muet depuis plus longtemps est affiche hors ligne.
DEVICE_OFFLINE_AFTER_SECONDS=60
